{
  "manifest_version": 3,
  "name": "PageLens",
  "version": "0.2.0",
  "description": "Inspect, preview, measure, and capture page designs. Collect assets, colors, typography, and layout references.",
  "homepage_url": "https://github.com/xorudra/pagelens",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open PageLens",
    "default_icon": "icon16.png"
  }
}
